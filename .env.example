# ==============================================================================
# ExoCortex Agent Configuration Template
# ==============================================================================

# Core Agent Settings
EXOCORTEX_ENV=development
EXOCORTEX_LOG_LEVEL=INFO
EXOCORTEX_DATA_DIR=~/.exocortex

# SLM Provider Settings
# Options: mock, onnx, local_server, llamacpp
EXOCORTEX_SLM_PROVIDER=mock
EXOCORTEX_MODEL_NAME=phi-3.5-mini-instruct
EXOCORTEX_MODEL_PATH=

# Hardware & Accelerator Settings
# Options: auto, qnn, dml, cpu
# - qnn: Qualcomm Snapdragon NPU Execution Provider (via ONNX Runtime QNN)
# - dml: DirectML (Snapdragon GPU / NPU fallback)
# - cpu: CPU Execution Provider
EXOCORTEX_HARDWARE_TARGET=auto

# Local Server Endpoint (if EXOCORTEX_SLM_PROVIDER=local_server)
EXOCORTEX_LOCAL_SERVER_URL=http://localhost:11434/v1
EXOCORTEX_LOCAL_SERVER_API_KEY=not-needed

# Safety & Permissions
EXOCORTEX_REQUIRE_CONFIRMATION_FOR_SENSITIVE=true
EXOCORTEX_MAX_PLAN_STEPS=10
